REACT_APP_CONTRACT_ADDRESS=your_deployed_youtube_contract_address
REACT_APP_READ_ONLY_RPC_URL=http://127.0.0.1:8545

# Choose one IPFS upload backend for browser uploads.
# Pinata is easiest for hosted demos:
REACT_APP_PINATA_JWT=your_pinata_jwt

# Or point at a local/CORS-enabled IPFS HTTP API:
# REACT_APP_IPFS_API_URL=http://127.0.0.1:5001
